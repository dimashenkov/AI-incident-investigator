# Копирай като .env. Истинският .env е в .gitignore и не влиза в repo-то.
#
# Ключът НЕ живее тук. Живее на едно място за всички проекти:
#     ~/.config/ai-sre/n8n.env   (права 600)
# и се зарежда с:
#     source ~/.config/ai-sre/n8n.env
#
# Тук стои само онова, което е специфично за проекта.

# Префикс на workflow-ите, които този проект притежава.
# Нищо извън този префикс не се пипа.
N8N_WORKFLOW_PREFIX='AI-SRE-MVP - '

# Доставчик на модел за агентите. Ключът стои в n8n Credentials, не тук.
MODEL_PROVIDER=openai

# The deployed workflow's id, printed by `npm run release` the first time it
# creates one. Set it so later releases update that workflow, and so drift is
# matched by id rather than by a name the n8n UI can change.
N8N_WORKFLOW_ID=
