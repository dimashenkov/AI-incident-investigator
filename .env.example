# Copy as .env. The real .env is in .gitignore and does not enter the repo.
#
# The key does NOT live here. It lives in one place for all projects:
#     ~/.config/ai-sre/n8n.env   (permissions 600)
# and is loaded with:
#     source ~/.config/ai-sre/n8n.env
#
# Only what is specific to the project stays here.

# Prefix of the workflows this project owns.
# Nothing outside this prefix is touched.
N8N_WORKFLOW_PREFIX='AI-SRE-MVP - '

# Model provider for the agents. The key lives in n8n Credentials, not here.
MODEL_PROVIDER=openai

# The deployed workflow's id, printed by `npm run release` the first time it
# creates one. Set it so later releases update that workflow, and so drift is
# matched by id rather than by a name the n8n UI can change.
N8N_WORKFLOW_ID=
