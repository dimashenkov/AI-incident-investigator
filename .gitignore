# ── secrets ──────────────────────────────────────────────────────────
.env
.env.local
*.key
*.pem
*credentials*.json
id_rsa
id_ed25519
.claude/settings.local.json

# ── working files: output, not source ────────────────────────────────
# Everything here is regenerated by the code. If a file must survive a clone,
# then it does not belong here.
scratch/
tmp/
.tmp/
out/
build/
dist/
coverage/
*.tmp
*.bak
*.orig
*.rej
*~

# ── logs and reports ─────────────────────────────────────────────────
*.log
logs/
# `runs/` used to stand here, and it matched `docs/runs/` — every record of
# every paid call since 2026-09-05, thirty-three files, invisible to git and
# absent from any clone. Found on 2026-09-11 when a new record refused to
# commit. Three written promises were false because of it: that every paid call
# is recorded as an artifact, that one command answers what it cost by reading
# the disk, and that the proof lives in the repository. It lived on one disk.
#
# Narrowed to the two directories it was written for. `docs/runs/` is the
# evidence and belongs in the repository.
/logs/runs/
/out/runs/
executions/
test-results/
.pytest_cache/
.vitest/

# ── n8n output ───────────────────────────────────────────────────────
# The raw export carries instance ids and credential references.
# Only the normalized one is version-controlled.
workflows/*.raw.json
workflows/.exports/

# ── Codex ────────────────────────────────────────────────────────────
# Neither the prompts nor the verdicts enter the repository (CLAUDE.md §6).
# Their content enters PROGRESS.md as a sentence.
codex/
*.codex.md
review-*.txt

# ── dependencies ─────────────────────────────────────────────────────
node_modules/
__pycache__/
.venv/
venv/

# ── machine and editor ───────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
