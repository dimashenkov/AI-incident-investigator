# значи не му е мястото тук.
scratch/
tmp/
.tmp/
out/
build/
dist/
coverage/
*.tmp
*.bak
*.orig
*.rej
*~

# ── логове и отчети ──────────────────────────────────────────────────
*.log
logs/
runs/
executions/
test-results/
.pytest_cache/
.vitest/

# ── n8n изход ────────────────────────────────────────────────────────
# Суровият export носи id-та и credential референции на instance-а.
# Version-controlled е само нормализираният.
workflows/*.raw.json
workflows/.exports/

# ── Codex ────────────────────────────────────────────────────────────
