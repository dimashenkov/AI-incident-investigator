{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sre-mvp/schemas/incident.schema.json",
  "title": "Incident",
  "description": "The one canonical incident object. Every part of the system reads and writes this shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "status",
    "service",
    "namespace",
    "cluster",
    "started_at",
    "source",
    "observations",
    "analysis",
    "remediation",
    "conversation"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "pattern": "^INC-[0-9]{4}-[0-9]{4}$",
      "description": "INC-YYYY-NNNN"
    },
    "status": {
      "type": "string",
      "enum": [
        "investigating",
        "diagnosed",
        "insufficient_evidence",
        "failed",
        "closed"
      ],
      "description": "failed and insufficient_evidence are distinct: could-not-determine is not the same as no-cause-found."
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "cluster": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "scenario": {
      "type": "string",
      "description": "Which fixture produced this incident. Null once providers are real.",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "alert"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "fake-datadog",
            "datadog"
          ]
        },
        "alert": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "triggered_at"
          ],
          "description": "The alert as it arrived. Closed and required: an empty object used to satisfy this, so an incident could claim a source that said nothing, and a typo'd key rode along unread.",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "triggered_at": {
              "type": "string",
              "format": "date-time"
            },
            "severity": {
              "$ref": "https://ai-sre-mvp/schemas/common.schema.json#/$defs/severity"
            },
            "monitor_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kubernetes",
        "logs",
        "metrics"
      ],
      "description": "Each key is either a collected object or explicitly null. A missing key is a schema error, not an empty observation; an empty object is not a collection; and a collected observation now has to have the shape its provider actually returns, rather than being any object at all.",
      "properties": {
        "kubernetes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://ai-sre-mvp/schemas/observations.schema.json#/$defs/kubernetes"
            }
          ],
          "description": "null means nothing was collected. Anything else must match the fixture contract for this slot — see schemas/observations.schema.json, which is derived from the scenario fixtures and is named a contract, not a provider shape, because that is the size of the evidence behind it."
        },
        "logs": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://ai-sre-mvp/schemas/observations.schema.json#/$defs/logs"
            }
          ],
          "description": "null means nothing was collected. Anything else must match the fixture contract for this slot — see schemas/observations.schema.json, which is derived from the scenario fixtures and is named a contract, not a provider shape, because that is the size of the evidence behind it."
        },
        "metrics": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://ai-sre-mvp/schemas/observations.schema.json#/$defs/metrics"
            }
          ],
          "description": "null means nothing was collected. Anything else must match the fixture contract for this slot — see schemas/observations.schema.json, which is derived from the scenario fixtures and is named a contract, not a provider shape, because that is the size of the evidence behind it."
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agents",
        "root_cause_code",
        "root_cause",
        "confidence",
        "evidence"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "$ref": "https://ai-sre-mvp/schemas/agent-result.schema.json"
          }
        },
        "root_cause_code": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "CONTAINER_OOM",
            "APPLICATION_STARTUP_FAILURE",
            "IMAGE_PULL_FAILURE",
            "READINESS_PROBE_FAILURE",
            "DEPLOYMENT_REGRESSION",
            "INSUFFICIENT_EVIDENCE",
            "CPU_THROTTLING",
            null
          ],
          "description": "The causes this system can name. A scenario whose correct answer is not in this list cannot be answered correctly at all — found 2026-09-04, when the cpu-throttling scenario expected a code the schema refused. tests/scenarios/expected.test.ts now requires every scenario's expected code to be here."
        },
        "root_cause": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0,
          "maximum": 1.0
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "fact",
              "supports"
            ],
            "properties": {
              "source": {
                "$ref": "https://ai-sre-mvp/schemas/common.schema.json#/$defs/evidenceSource"
              },
              "fact": {
                "type": "string",
                "minLength": 1
              },
              "supports": {
                "type": "string",
                "enum": [
                  "for",
                  "against"
                ],
                "description": "Which way this points. Required: an unstated direction was indistinguishable from support, so an incident could be diagnosed on evidence that in fact contradicted it."
              }
            }
          }
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommended_actions"
      ],
      "properties": {
        "recommended_actions": {
          "type": "array",
          "items": {
            "$ref": "https://ai-sre-mvp/schemas/remediation.schema.json"
          }
        }
      }
    },
    "conversation": {
      "$ref": "https://ai-sre-mvp/schemas/conversation.schema.json"
    }
  },
  "allOf": [
    {
      "description": "A diagnosed incident must carry a code, a confidence and at least one piece of evidence. Absence is not a diagnosis.",
      "if": {
        "properties": {
          "status": {
            "const": "diagnosed"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "analysis": {
            "required": [
              "root_cause_code",
              "confidence",
              "evidence"
            ],
            "properties": {
              "root_cause_code": {
                "type": "string",
                "not": {
                  "const": "INSUFFICIENT_EVIDENCE"
                }
              },
              "root_cause": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Zero confidence is not a diagnosis. No upper threshold is set here because none has been measured."
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "properties": {
                    "supports": {
                      "const": "for"
                    }
                  },
                  "required": [
                    "supports"
                  ]
                },
                "description": "At least one piece of evidence must point FOR the conclusion. A diagnosis resting only on contradicting evidence used to pass."
              },
              "agents": {
                "type": "array",
                "minItems": 1,
                "description": "A diagnosis with no agent behind it validated: zero agents, evidence from nowhere, and a root cause. At least one agent must have run."
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "description": "insufficient_evidence must say so in the code, so the two states cannot silently merge.",
      "if": {
        "properties": {
          "status": {
            "const": "insufficient_evidence"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "analysis": {
            "properties": {
              "root_cause_code": {
                "const": "INSUFFICIENT_EVIDENCE"
              }
            },
            "required": [
              "root_cause_code"
            ],
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ]
}
